---
import SPInstrument from '../SPInstrument.astro';
import SPPart from '../SPPart.astro';
import {part,type Shape} from '../../lib/penpot';
import article from '../../content/first-change.json';
import snapshot from '../../../design/penpot/guide-components.json';
import scenes from '../../content/guide-scenes.json';
import AnimationTimeline from './AnimationTimeline.astro';
interface Props {kind:string;}
const {kind}=Astro.props;
const screen=snapshot.components.find(c=>c.name==='Menu title screen')!.shape as Shape;
const selections=['System','Pad set','EFX set','Import','Backup','Format'];
---
{kind==='hero'&&<guide-motion class="guide-instrument-hero" data-mode="instrument">
  <div class="guide-instrument"><SPInstrument screenPart={screen} screenLabel="CUSTOM MENU!"/></div>
  <div class="hero-observation"><p class="observed-title">CUSTOM<br/> MENU!</p><p>The menu check after the candidate was installed.</p><AnimationTimeline {...scenes.instrument}/><p class="motion-status">{scenes.instrument.steps.at(-1)}</p><p class="figure-label reconstruction">Title-only reconstruction<br/>Illustrative timing / no device connection</p></div>
</guide-motion>}
{kind==='files'&&<div class="update-files">
  {[['SP404MKII_APP0.bin','2,359,296 bytes. Opaque body; role still under investigation.'],['SP404MKII_APP1.bin','2,652,672 bytes. Readable strings and ARM instructions.']].map(([name,note])=><div><code>{name}</code><p>{note}</p></div>)}
  <p class="figure-label">Originals preserved / SHA-256 recorded</p>
  <details class="input-hashes"><summary>Our v5.52 SHA-256 record</summary><dl><dt>APP0</dt><dd><code>3e35ff30137f741a715566e205384f9b434ca7ac3847e247bad3f0c9c8a2bd23</code></dd><dt>APP1</dt><dd><code>4a3d67711e14dcc97d50249a4eee7dd6df0251a2f37757cbbe2556c233730d80</code></dd></dl></details>
</div>}
{kind==='memory'&&<guide-motion class="runtime-diagram" data-mode="memory">
  <div class="region-headings" aria-hidden="true"><span>Stored representation</span><span>Operation</span><span>Runtime result</span></div>
  <ol class="region-rows">{[['41 42 43 44','Copy','41 42 43 44'],['A × 4','Expand','41 41 41 41'],['No payload','Zero-fill','00 00 00 00']].map(([source,operation,result],i)=><li data-region={i} data-result={result}><code>{source}</code><span class="region-operation">{operation}<svg viewBox="0 0 80 12" aria-hidden="true"><path d="M0 6h78m-5-5 5 5-5 5"/></svg></span><code data-destination>{result}</code></li>)}</ol>
  <AnimationTimeline {...scenes.memory}/><p class="motion-status">{scenes.memory.steps.at(-1)}</p>
</guide-motion>}
{kind==='code'&&<guide-motion class="ida-excerpt" data-mode="code">
  <div class="code-heading"><span class="figure-label">IDA / pseudocode excerpt</span></div>
  <ol class="reference-trace"><li data-trace>String: <code>UTILITY MENU</code></li><li data-trace>Reference: <code>aUtilityMenu</code></li><li data-trace>Consumer: title drawing call</li></ol>
  <pre tabindex="0" aria-label="Utility menu drawing function"><code>{article.code.map((line,i)=><span class:list={['code-line',{'code-focus':i===3}]} data-line={i}><span class="line-number" aria-hidden="true">{i+1}</span><span>{i===3?<><span>  sub_800C2558((int)a1, (int)</span><mark>aUtilityMenu</mark><span>, -98);</span></>:line}</span></span>)}</code></pre>
  <p class="code-explanation">The title reference is passed to a drawing call. The familiar <code>SYSTEM</code> label below helps identify the menu.</p>
  <AnimationTimeline {...scenes.code}/><p class="motion-status">{scenes.code.steps.at(-1)}</p>
</guide-motion>}
{kind==='scope'&&<dl class="experiment-scope"><div><dt>Keep</dt><dd>Stock startup, menu drawing, APP0</dd></div><div><dt>Change</dt><dd>One title in APP1</dd></div></dl>}
{kind==='comparison'&&<guide-motion class="menu-comparison" data-mode="comparison">
  <div class="title-pair">{[['Original title','UTILITY MENU'],['Modified title','CUSTOM MENU!']].map(([label,title])=><div><p class="figure-label">{label}</p><div class="comparison-screen"><svg viewBox="0 0 128 64" width="128" height="64" role="img" aria-label={title}><SPPart node={screen} label={title}/></svg></div></div>)}</div>
  <div class="character-diff" aria-label="Twelve printable ASCII bytes and an unchanged zero terminator">{[['Before','UTILITY MENU'],['After','CUSTOM MENU!']].map(([label,title],row)=><div><span class="diff-label">{label}</span><code>{[...title].map((c,i)=><span data-character={row?i:undefined}>{c===' '?'·':c}<small>{c.charCodeAt(0).toString(16).toUpperCase()}</small></span>)}<span class="terminator" aria-label="zero terminator">NUL<small>00</small></span></code></div>)}</div>
  <AnimationTimeline {...scenes.comparison}/><p class="motion-status">{scenes.comparison.steps.at(-1)}</p>
</guide-motion>}
{kind==='verification'&&<guide-motion class="verification-wrap" data-mode="verification"><table class="verification-table"><caption>Menu-drawing cases / recorded CPU results</caption><thead><tr><th scope="col">Selection</th><th scope="col">Original</th><th scope="col">Modified</th></tr></thead><tbody>{selections.map((name,i)=><tr><th scope="row">{name}</th><td data-case={i*2}>Pass</td><td data-case={i*2+1}>Pass</td></tr>)}</tbody></table><AnimationTimeline {...scenes.verification}/><p class="motion-status">{scenes.verification.steps.at(-1)}</p><p class="figure-label">CPU tests / not device tests</p></guide-motion>}
{kind==='result'&&<div class="hardware-result"><div class="result-parts"><div><svg viewBox="0 0 46 39" width="92" height="78" aria-hidden="true"><SPPart node={part('Button')} label="SHIFT"/></svg><span>SHIFT</span></div><span class="combination-plus" aria-hidden="true">+</span><div><svg viewBox="0 0 46 39" width="92" height="78" aria-hidden="true"><SPPart node={part('Pad - idle')} label="13"/></svg><span>PAD 13</span></div><span class="result-arrow" aria-hidden="true">→</span><div class="result-screen"><svg viewBox="0 0 128 64" width="256" height="128" role="img" aria-label="CUSTOM MENU! title reconstruction"><SPPart node={screen} label="CUSTOM MENU!"/></svg></div></div><blockquote><p>“it wokred”</p><footer>Owner report / 22 September 2026</footer></blockquote><p>Reported visible success. No independent screen capture or installed-image readback.</p></div>}
<script>import '../../scripts/guide-motion';</script>
